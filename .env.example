# Environment variables for SIH PS-6188 Document Screening System
# Copy this file to .env and fill in the values

# Google Gemini API key (for LLM plain-language summary)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Checkpoint identifier (set per deployment location)
CHECKPOINT_ID=SSB-CHECKPOINT-001

# Officer ID (set per officer session)
OFFICER_ID=officer_001

# NFC reader available at this post (true/false)
NFC_AVAILABLE=false
